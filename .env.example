# Local development. Copy to .env in the repo root.

# PostgreSQL (local Docker maps 5436)
DATABASE_URL="postgresql://splitbill:splitbill@localhost:5436/splitbill"
DIRECT_URL="postgresql://splitbill:splitbill@localhost:5436/splitbill"

# Express API
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3030
ALLOW_VERCEL_PREVIEWS=false
LOG_LEVEL=info

# Receipt parser: "mock" | "openai"
RECEIPT_PARSER=mock
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4o

# Object storage: "local" | "r2" (production must be r2)
STORAGE=local
UPLOAD_DIR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Next.js (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
