# Copy to .env in the repo root and to apps/api/.env (Prisma reads apps/api/.env).

# PostgreSQL
DATABASE_URL="postgresql://splitbill:splitbill@localhost:5436/splitbill"

# Express API
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3030
LOG_LEVEL=info

# Receipt parser: "mock" | "openai"
RECEIPT_PARSER=mock
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4o

# Next.js (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
